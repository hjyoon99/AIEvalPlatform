FROM node:22-alpine

WORKDIR /app/packages/sdk

COPY packages/sdk/package.json ./
RUN npm install
COPY packages/sdk ./
RUN npm run build

WORKDIR /app
COPY examples/sdk-test-worker.mjs examples/sdk-test-worker.mjs

ENV AIEVAL_BASE_URL=http://backend:3000/api/v1
CMD ["node", "examples/sdk-test-worker.mjs"]
