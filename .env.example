# Docker Compose 공개 포트
POSTGRES_PORT=5433
BACKEND_PORT=3000
DASHBOARD_PORT=5173
MOCK_AGENT_ENGINE_PORT=18000
AGENT_ENGINE_PORT=8000

# 로컬 테스트 DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eval_platform

# 브라우저에서 접근할 Backend API
VITE_API_URL=http://localhost:3000/api/v1

# 실제 평가/시나리오 생성 엔진이 접근할 Ollama
OLLAMA_HOST=http://host.docker.internal:11434

# ADAPTER 프로필을 사용할 때 발급받은 aieval_ 형식 키
AIEVAL_SDK_KEY=

# Judge Worker polling 간격
JUDGE_WORKER_POLL_INTERVAL_MS=500
