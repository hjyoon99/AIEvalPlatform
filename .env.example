# Docker Compose 공개 포트
POSTGRES_PORT=5433
BACKEND_PORT=3000
DASHBOARD_PORT=5173
MOCK_AGENT_ENGINE_PORT=18000
AGENT_ENGINE_PORT=8000

# 로컬 테스트 DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eval_platform

# 브라우저에서 접근할 Backend API
VITE_API_URL=http://localhost:3000/api/v1

# 실제 평가/시나리오 생성 엔진이 접근할 Ollama
OLLAMA_HOST=http://host.docker.internal:11434

# ADAPTER 프로필을 사용할 때 발급받은 aieval_ 형식 키
AIEVAL_SDK_KEY=

# Judge Worker polling 간격
JUDGE_WORKER_POLL_INTERVAL_MS=500

# 동시에 처리할 Judge 작업 수. 슬롯 하나당 Agent Engine 호출 1건이 동시에
# 나가고 그 안에서 Ollama가 여러 번 순차 호출되므로, 로컬 Ollama 하나로
# 돌린다면 과도하게 올리지 않는다.
JUDGE_WORKER_CONCURRENCY=4
